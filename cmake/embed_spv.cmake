# Embed a list of compiled SPIR-V (.spv) binaries into a single C header as uint32_t arrays.
# Usage:
#   cmake -DINPUT_DIR=<dir> -DOUTPUT_HEADER=<path> -DENTRY_LIST="a;b;c" -P embed_spv.cmake

if(NOT INPUT_DIR OR NOT OUTPUT_HEADER OR NOT ENTRY_LIST)
    message(FATAL_ERROR "embed_spv.cmake requires INPUT_DIR, OUTPUT_HEADER, and ENTRY_LIST")
endif()

set(_out "/* Auto-generated by embed_spv.cmake from Slang AOT SPIR-V outputs. */\n")
string(APPEND _out "#ifndef VELRI_VK_SHADERS_H\n#define VELRI_VK_SHADERS_H\n\n")
string(APPEND _out "#include <stddef.h>\n#include <stdint.h>\n\n")

foreach(_entry IN LISTS ENTRY_LIST)
    set(_spv "${INPUT_DIR}/${_entry}.spv")
    if(NOT EXISTS "${_spv}")
        message(FATAL_ERROR "Missing SPIR-V file: ${_spv}")
    endif()
    file(READ "${_spv}" _hex HEX)
    string(LENGTH "${_hex}" _hex_len)
    math(EXPR _nbytes "${_hex_len} / 2")
    math(EXPR _rem "${_nbytes} % 4")
    if(NOT _rem EQUAL 0)
        message(FATAL_ERROR "SPIR-V binary ${_spv} size (${_nbytes}) is not a multiple of 4")
    endif()

    # Convert little-endian byte hex string (8 hex chars per word) to C uint32_t literals.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
        "0x\\4\\3\\2\\1u," _words "${_hex}")
    string(REGEX REPLACE "((0x[0-9a-f]+u,){8})" "    \\1\n" _formatted "${_words}")

    string(APPEND _out "static const uint32_t spv_${_entry}[] = {\n${_formatted}\n};\n")
    string(APPEND _out "static const size_t spv_${_entry}_bytes = ${_nbytes}u;\n\n")
endforeach()

string(APPEND _out "#endif /* VELRI_VK_SHADERS_H */\n")
get_filename_component(_parent "${OUTPUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${_parent}")
file(WRITE "${OUTPUT_HEADER}" "${_out}")
