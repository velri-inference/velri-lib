# Each production entry point has one uniform push-constant struct. Specializations of
# the same Slang struct must agree on its C representation, including every field offset.
set(header "/* Generated Vulkan push constants. */\n#pragma once\n#include \"vk_internal.h\"\n\n")
foreach(input IN LISTS INPUTS)
    file(READ "${input}" reflection)
    string(JSON scope GET "${reflection}" entryPoints 0 scope)
    string(JSON binding GET "${scope}" binding kind)
    if(NOT binding STREQUAL "pushConstantBuffer")
        message(FATAL_ERROR "Expected push constants in ${input}")
    endif()
    string(JSON count LENGTH "${scope}" parameters)
    math(EXPR last "${count} - 1")
    unset(parameter)
    foreach(i RANGE ${last})
        string(JSON kind ERROR_VARIABLE missing GET "${scope}" parameters ${i} binding kind)
        if(NOT missing AND kind STREQUAL "uniform")
            if(DEFINED parameter)
                message(FATAL_ERROR "Expected one uniform push-constant struct in ${input}")
            endif()
            string(JSON parameter GET "${scope}" parameters ${i})
        endif()
    endforeach()
    if(NOT DEFINED parameter)
        message(FATAL_ERROR "Missing uniform push-constant struct in ${input}")
    endif()
    string(JSON name GET "${parameter}" type name)
    string(REGEX REPLACE "([A-Z]+)([A-Z][a-z])" "\\1_\\2" c_name "${name}")
    string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" c_name "${c_name}")
    string(TOLOWER "vk_${c_name}" c_name)
    string(JSON size GET "${parameter}" binding size)
    string(JSON fields GET "${parameter}" type fields)
    string(JSON count LENGTH "${fields}")
    math(EXPR last "${count} - 1")
    set(declaration "typedef struct {\n")
    set(checks "static_assert(sizeof(${c_name}) == ${size});\n")
    string(APPEND checks "static_assert(sizeof(${c_name}) <= VK_MAX_PC_BYTES);\n")
    foreach(i RANGE ${last})
        string(JSON field GET "${fields}" ${i})
        string(JSON member GET "${field}" name)
        string(JSON offset GET "${field}" binding offset)
        string(JSON alignment GET "${field}" type sizes 0 alignment)
        string(JSON kind GET "${field}" type kind)
        if(kind STREQUAL "pointer")
            set(type uint64_t) # Vulkan device address
        elseif(kind STREQUAL "scalar")
            string(JSON scalar GET "${field}" type scalarType)
            if(scalar STREQUAL "uint32")
                set(type uint32_t)
            elseif(scalar STREQUAL "float32")
                set(type float)
            else()
                message(FATAL_ERROR "Unsupported ${name}.${member} scalar '${scalar}'")
            endif()
        else()
            message(FATAL_ERROR "Unsupported ${name}.${member} type '${kind}'")
        endif()
        string(APPEND declaration "    alignas(${alignment}) ${type} ${member};\n")
        string(APPEND checks "static_assert(offsetof(${c_name}, ${member}) == ${offset});\n")
    endforeach()
    string(APPEND declaration "} ${c_name};\n${checks}\n")
    if(DEFINED layout_${c_name})
        if(NOT declaration STREQUAL layout_${c_name})
            message(FATAL_ERROR "Incompatible specializations of ${name} in ${input}")
        endif()
    else()
        set(layout_${c_name} "${declaration}")
        string(APPEND header "${declaration}")
    endif()
endforeach()
file(WRITE "${OUTPUT}" "${header}")
